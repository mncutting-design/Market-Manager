# ==========================================
# MARKET MANAGER - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE CONFIGURATION
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Cloud Production (PostgreSQL - Neon, Supabase, Railway, Vercel Postgres):
# Change provider in prisma/schema.prisma to "postgresql"
# DATABASE_URL="postgresql://user:password@host:5432/market_manager?sslmode=require"

# 2. AUTHENTICATION & SECURITY
# Generate a strong random 32+ character key (e.g. openssl rand -base64 32)
AUTH_SECRET="market-manager-production-secret-key-32-chars-minimum"

# 3. APPLICATION URL
# For Local:
NEXTAUTH_URL="http://localhost:3000"
# For Production:
# NEXTAUTH_URL="https://your-domain.vercel.app"
