generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("ADMIN") // ADMIN, MANAGER, COLLECTOR, OPERATOR, VIEWER
  locale       String   @default("bn")    // bn, en
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentsReceived    Payment[]             @relation("PaymentReceivedBy")
  paymentsEntered     Payment[]             @relation("PaymentEnteredBy")
  expensesEntered     Expense[]             @relation("ExpenseEnteredBy")
  topUpRequests       AdvanceTopUpRequest[] @relation("TopUpRequestedBy")
  depositCounterparty DepositTransaction[]  @relation("DepositCounterpartyUser")
  depositEntered      DepositTransaction[]  @relation("DepositEnteredByUser")
  depositApproved     DepositTransaction[]  @relation("DepositApprovedByUser")
}

model Market {
  id        String    @id @default(cuid())
  name      String
  address   String?
  notes     String?
  totalFloors Int       @default(5)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shops               Shop[]
  expenses            Expense[]
  depositTransactions DepositTransaction[]

  @@index([isActive])
}

model Shop {
  id          String   @id @default(cuid())
  marketId    String
  shopNumber  String
  floor       String   @default("Ground")
  size        String?  // e.g. "180 sqft"
  defaultRent Int      // stored in paisa (1 BDT = 100 paisa)
  status      String   @default("VACANT") // OCCUPIED, VACANT
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  market              Market               @relation(fields: [marketId], references: [id], onDelete: Cascade)
  tenants             Tenant[]
  bills               Bill[]
  rentHistory         RentHistory[]
  settlements         Settlement[]
  depositTransactions DepositTransaction[]

  @@unique([marketId, shopNumber])
  @@index([marketId])
  @@index([status])
  @@index([isActive])
}

model Tenant {
  id                String    @id @default(cuid())
  shopId            String
  name              String
  phone             String
  nid               String?
  permanentAddress  String?
  referenceName     String?
  referencePhone    String?
  referenceRelation String?
  photoUrl          String?
  documentUrl       String?
  /// @deprecated Stored for backwards compatibility. All deposit balances MUST be computed from DepositTransaction ledger.
  advanceDeposit    Int       @default(0) // in paisa (legacy/migration reference)
  rentAmount        Int       // current agreed rent in paisa
  status            String    @default("ACTIVE") // ACTIVE, NOTICE_GIVEN, SETTLED, ARCHIVED
  startDate         DateTime  @default(now())
  endDate           DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop                Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bills               Bill[]
  rentHistory         RentHistory[]
  advanceTransactions AdvanceTransaction[]
  depositTransactions DepositTransaction[]
  settlements         Settlement[]
  topUpRequests       AdvanceTopUpRequest[]

  @@index([shopId])
  @@index([status])
  @@index([isActive])
  @@index([phone])
}

model AdvanceTransaction {
  id                  String   @id @default(cuid())
  tenantId            String
  type                String   // DEPOSIT_RECEIVED, ADJUSTED_TO_DUE, DEDUCTION, REFUND, TOPUP
  amount              Int      // in paisa (always positive)
  relatedBillId       String?
  relatedSettlementId String?
  reason              String
  createdBy           String   @default("Admin")
  createdByName       String?
  enteredById         String?
  createdAt           DateTime @default(now())

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relatedBill       Bill?       @relation(fields: [relatedBillId], references: [id], onDelete: SetNull)
  relatedSettlement Settlement? @relation(fields: [relatedSettlementId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
  @@index([enteredById])
}

model Settlement {
  id                String   @id @default(cuid())
  tenantId          String
  shopId            String
  status            String   @default("CONFIRMED") // DRAFT, CONFIRMED
  totalDue          Int      // in paisa
  advanceBalance    Int      // in paisa (before settlement)
  totalDeductions   Int      // in paisa
  refundAmount      Int      @default(0) // in paisa
  unrecoveredAmount Int      @default(0) // in paisa
  deductionsJson    String   @default("[]") // JSON string of deduction items
  policyVersionId   String?
  notes             String?
  settledAt         DateTime @default(now())
  confirmedBy       String   @default("Admin")
  createdAt         DateTime @default(now())

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop                Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  policyVersion       PolicyVersion?       @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)
  advanceTransactions AdvanceTransaction[]
  depositTransactions DepositTransaction[]

  @@index([tenantId])
  @@index([shopId])
  @@index([status])
  @@index([settledAt])
}

model TenantPolicy {
  id        String   @id @default(cuid())
  scope     String   @default("GLOBAL") // GLOBAL, MARKET, TENANT
  marketId  String?  @unique
  tenantId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions PolicyVersion[]

  @@index([scope])
}

model PolicyVersion {
  id                        String   @id @default(cuid())
  policyId                  String
  versionNumber             Int
  effectiveFrom             DateTime @default(now())

  // Policy Settings
  requiredAdvanceMonths     Int      @default(3)
  requiredAdvanceFixed      Int?
  rentDueDay                Int      @default(10)
  gracePeriodDays           Int      @default(5)
  lateFeeType               String   @default("NONE") // NONE, FIXED, PERCENTAGE, DAILY
  lateFeeAmount             Int      @default(0) // in paisa or percent basis points
  lateFeeCap                Int?     // cap in paisa
  noticePeriodDays          Int      @default(30)
  noticePenaltyAmount       Int      @default(0) // in paisa
  advanceRefundDeadlineDays Int      @default(15)
  requireAdvanceTopup       Boolean  @default(true)
  annualRentIncreasePercent Int      @default(10)
  contractExpiryWarningDays Int      @default(60)

  // JSON configurations
  overdueEscalationJson     String   @default("[]")
  allowedDeductionsJson     String   @default("[]")

  // Human-readable Rules text
  rulesTextEn               String   @default("")
  rulesTextBn               String   @default("")

  createdById               String?
  createdAt                 DateTime @default(now())

  policy      TenantPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  settlements Settlement[]

  @@index([policyId])
  @@index([effectiveFrom])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String   @default("Admin")
  action      String   // ADVANCE_DEPOSIT, ADVANCE_ADJUSTMENT, ADVANCE_DEDUCTION, ADVANCE_REFUND, SETTLEMENT_CONFIRMED, POLICY_CHANGED, BILL_WAIVED, etc.
  entityType  String   // Tenant, AdvanceTransaction, Settlement, Policy, Bill
  entityId    String
  detailsJson String   @default("{}")
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model RentHistory {
  id            String   @id @default(cuid())
  shopId        String
  tenantId      String?
  rentAmount    Int      // in paisa
  effectiveFrom DateTime // effective start month
  note          String?
  createdAt     DateTime @default(now())

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([tenantId])
}

model ChargeType {
  id            String   @id @default(cuid())
  name_en       String
  name_bn       String
  isRecurring   Boolean  @default(true)
  defaultAmount Int      @default(0) // in paisa
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  billItems BillItem[]

  @@index([isActive])
}

model Bill {
  id          String   @id @default(cuid())
  shopId      String
  tenantId    String
  month       Int      // 1 to 12
  year        Int      // e.g. 2026
  rentAmount  Int      // in paisa
  totalAmount Int      // in paisa (rent + bill items)
  paidAmount  Int      @default(0) // in paisa
  dueAmount   Int      // in paisa (totalAmount - paidAmount)
  status      String   @default("DUE") // PAID, PARTIAL, DUE, SETTLED_FROM_ADVANCE, WAIVED
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop                Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billItems           BillItem[]
  payments            Payment[]
  advanceTransactions AdvanceTransaction[]
  depositTransactions DepositTransaction[]

  @@unique([shopId, month, year])
  @@index([shopId])
  @@index([tenantId])
  @@index([month, year])
  @@index([status])
}

model BillItem {
  id           String      @id @default(cuid())
  billId       String
  chargeTypeId String?
  description  String
  amount       Int         // in paisa
  createdAt    DateTime    @default(now())

  bill       Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  chargeType ChargeType? @relation(fields: [chargeTypeId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([chargeTypeId])
}

model Payment {
  id               String   @id @default(cuid())
  billId           String
  amount           Int      // in paisa
  paidOn           DateTime @default(now())
  method           String   @default("CASH") // CASH, BKASH, NAGAD, BANK, CHEQUE, ADVANCE_ADJUSTMENT
  reference        String?
  note             String?
  receivedBy       String?  // Name (display)
  receivedById     String?  // User ID of collector staff
  enteredById      String?  // User ID who entered payment
  paymentAccountId String?  // Account ID for bKash, Nagad, Bank
  transactionRef   String?  // TrxID / Cheque Number
  senderNumber     String?  // e.g. bKash/Nagad sender phone number
  bankName         String?  // Selected bank name
  collectorId      String?  // ID of collector from Collector table
  createdAt        DateTime @default(now())

  bill             Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  receivedByUser   User?           @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  enteredByUser    User?           @relation("PaymentEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  collector        Collector?      @relation(fields: [collectorId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([paidOn])
  @@index([receivedById])
  @@index([enteredById])
  @@index([paymentAccountId])
  @@index([collectorId])
}

model Collector {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payments  Payment[]

  @@index([isActive])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name_en   String
  name_bn   String
  icon      String   @default("Wrench") // Lucide icon name
  color     String   @default("#0d9488")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([isActive])
}

model Expense {
  id            String   @id @default(cuid())
  marketId      String
  categoryId    String
  amount        Int      // in paisa
  date          DateTime @default(now())
  description   String?
  attachmentUrl String?
  paymentMethod String   @default("CASH") // CASH, BKASH, NAGAD, BANK, CHEQUE
  enteredById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  market        Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  enteredByUser User?           @relation("ExpenseEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@index([marketId])
  @@index([categoryId])
  @@index([date])
  @@index([enteredById])
}

model ChangeRequest {
  id            String    @id @default(cuid())
  entityType    String    // MARKET, SHOP, TENANT, BILL, EXPENSE
  entityId      String
  entityTitle   String?   // e.g. "ফাতেমা কাটিং" or "দোকান ১০১"
  actionType    String    // EDIT, DELETE, RENT_REVISION, ADDITIONAL_CHARGE
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  currentData   String    // JSON string of current state ("what have")
  proposedData  String    // JSON string of proposed changes ("what will have")
  requestedBy   String    @default("Manager")
  requesterRole String    @default("MANAGER")
  reviewedBy    String?
  reviewNote    String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  @@index([status])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AdvanceTopUpRequest {
  id            String    @id @default(cuid())
  tenantId      String
  amount        Int       // in paisa
  method        String    @default("CASH") // CASH, BKASH, NAGAD, BANK, CHEQUE
  note          String?
  requestedBy   String    // User name
  requestedById String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedBy     String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByUser User?  @relation("TopUpRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([requestedById])
}

model PaymentAccount {
  id          String    @id @default(cuid())
  accountType String    // BKASH, NAGAD, BANK
  name_en     String
  name_bn     String
  number      String    // Phone or Account number
  bankName    String?   // Sonali, Janata, Agrani, Rupali, Islami, Dutch-Bangla, City, BRAC, Other
  branch      String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments            Payment[]
  depositTransactions DepositTransaction[]

  @@index([accountType])
  @@index([isActive])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  // Target user, or null for role broadcast
  role      String?  // Target role e.g. "ADMIN", "MANAGER", "COLLECTOR"
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, APPROVAL
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([role])
  @@index([isRead])
  @@index([createdAt])
}

model DepositTransaction {
  id                    String    @id @default(cuid())
  marketId              String
  tenantId              String
  shopId                String
  type                  String    // RECEIVED, TOPUP, REFUND, ADJUSTED_TO_DUE, DEDUCTION, REVERSAL
  amount                Int       // in paisa (positive integer paisa, always positive)
  transactionDate       DateTime  @default(now())
  method                String    @default("CASH") // CASH, BKASH, NAGAD, BANK, CHEQUE
  paymentAccountId      String?
  bankName              String?
  transactionRef        String?   // TrxID / Cheque Number
  counterpartyUserId    String?   // received by for inflow, paid by for outflow
  enteredById           String?   // set by server from session, never from client
  reason                String    // supports Bangla
  relatedBillId         String?
  relatedSettlementId   String?
  reversesTransactionId String?
  status                String    @default("POSTED") // POSTED, PENDING_APPROVAL, REJECTED
  rejectionReason       String?
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime  @default(now())

  market              Market               @relation(fields: [marketId], references: [id], onDelete: Cascade)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop                Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  relatedBill         Bill?                @relation(fields: [relatedBillId], references: [id], onDelete: SetNull)
  relatedSettlement   Settlement?          @relation(fields: [relatedSettlementId], references: [id], onDelete: SetNull)
  paymentAccount      PaymentAccount?      @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  counterpartyUser    User?                @relation("DepositCounterpartyUser", fields: [counterpartyUserId], references: [id], onDelete: SetNull)
  enteredByUser       User?                @relation("DepositEnteredByUser", fields: [enteredById], references: [id], onDelete: SetNull)
  approvedByUser      User?                @relation("DepositApprovedByUser", fields: [approvedById], references: [id], onDelete: SetNull)
  reversesTransaction DepositTransaction?  @relation("DepositReversal", fields: [reversesTransactionId], references: [id], onDelete: SetNull)
  reversedBy          DepositTransaction[] @relation("DepositReversal")

  @@index([tenantId, transactionDate])
  @@index([marketId, transactionDate])
  @@index([type])
  @@index([status])
  @@index([shopId])
  @@index([reversesTransactionId])
  @@index([enteredById])
  @@index([paymentAccountId])
}

